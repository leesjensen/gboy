{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  // Supabase CLI config for GBoy (Giant Book of Yum). The scripts run the CLI with
  // `--workdir install`, so this folder is the project's supabase/ directory.
  //
  // Only the settings this project relies on are declared. `supabase config
  // push` changes exactly these on the hosted project and leaves everything
  // else alone; `supabase start` uses CLI defaults for the rest.
  // Reference: https://supabase.com/docs/guides/local-development/cli/config
  "project_id": "gboy",

  "db": {
    // Must match the hosted database (SHOW server_version;).
    "major_version": 17,
    "seed": {
      "enabled": true,
      // Generated from data/recipes.json by seed_recipes.sh (git-ignored).
      "sql_paths": ["./seed.sql"]
    }
  },

  "auth": {
    // Set in install/supabase/.env.
    "site_url": "env(SITE_URL)",
    "additional_redirect_urls": ["http://localhost:5173/", "http://localhost:4173/"],
    // Anyone can sign in by email to rate recipes. New accounts get no
    // rights; editing still requires an admin grant (add_admin.sh).
    "enable_signup": true,

    "rate_limit": {
      // Sign-in emails per hour across the whole site (Supabase's default is
      // 30 once custom SMTP is on).
      "email_sent": 100
    },

    "email": {
      "enabled": true,
      // Accounts must confirm their email before signing in, so ratings can't
      // be stuffed with made-up addresses through password sign-up.
      "enable_confirmations": true,
      "max_frequency": "60s",
      // People sign in with a 6-digit code (templates below) that expires
      // after 10 minutes. Codes need custom SMTP: the built-in mailer doesn't
      // allow custom templates.
      "otp_length": 6,
      "otp_expiry": 600,

      // signInWithOtp sends the magic link template to existing users and the
      // confirmation template to new ones; both show the code ({{ .Token }}).
      "template": {
        "magic_link": {
          "subject": "Your Giant Book of Yum sign-in code",
          "content_path": "./supabase/templates/magic_link.html"
        },
        "confirmation": {
          "subject": "Confirm your email for the Giant Book of Yum",
          "content_path": "./supabase/templates/confirmation.html"
        }
      },

      // Amazon SES (Mail Manager authenticated ingress endpoint). Values live
      // in install/supabase/.env, which is git-ignored.
      "smtp": {
        "enabled": true,
        "host": "env(SMTP_HOST)",
        "port": 587,
        "user": "env(SMTP_USER)",
        "pass": "env(SMTP_PASS)",
        "admin_email": "env(SMTP_ADMIN_EMAIL)",
        "sender_name": "Giant Book of Yum"
      }
    }
  },

  "functions": {
    // Reads a recipe from a photo with Gemini (functions/import-recipe). The
    // function checks the caller's session and admin role itself, which also
    // works with Supabase's newer JWT signing keys.
    "import-recipe": {
      "verify_jwt": false
    }
  }
}
