# Copy to install/supabase/.env (git-ignored). The Supabase CLI also reads
# this file for env(...) values in config.jsonc.

# Where the site is served; used for auth redirects and email links.
# For local-only work this can be http://localhost:5173/
SITE_URL=https://example.github.io/gboy/

# Used by setup.sh. Leave SUPABASE_PROJECT_REF blank to create a new project
# in SUPABASE_ORG_ID (see `supabase orgs list`).
SUPABASE_PROJECT_REF=
SUPABASE_ORG_ID=
SUPABASE_PROJECT_NAME=gboy-recipe-book
SUPABASE_REGION=us-west-1
# Database password; the CLI uses it for link and db push.
SUPABASE_DB_PASSWORD=

# Only needed if you enable the smtp block in config.jsonc.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
